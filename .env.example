# Public analytics identifiers (safe to expose in the browser bundle)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional direct Google Ads conversion. Leave both blank when the GA4
# generate_lead key event is the only conversion imported into Google Ads.
NEXT_PUBLIC_GADS_CONVERSION_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GADS_LEAD_LABEL=XXXXXXXXXXXX

# Server-only secrets. Set real values in the deployment environment, never here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
